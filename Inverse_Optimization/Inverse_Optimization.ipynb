mus  = [float(df.loc[lbl,"total_MU"])  for lbl in labels]
nucs = [float(df.loc[lbl,"nuc_norm"])  for lbl in labels]
for i,(lbl,mu,nuc) in enumerate(zip(labels,mus,nucs)):
    ax_sc.scatter(mu, nuc, s=160, color=PAL[i%4], zorder=4,
